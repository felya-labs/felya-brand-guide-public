  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "brand": {
        "$value": [
          "Manrope",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "sans-serif"
        ]
      }
    },
    "fontWeight": {
      "$type": "number",
      "regular": {
        "$value": 400
      },
      "text": {
        "$value": 520
      },
      "bold": {
        "$value": 700
      },
      "eyebrow": {
        "$value": 750
      }
    },
    "fontSize": {
